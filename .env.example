# Hugging Face 
HUGGINGFACE_API_KEY=your_key_here

# Modèle Embedding 
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Modèle génération (Ollama)
GENERATION_MODEL=mistral:7b-instruct

# Modèle génération (HuggingFace, si pas Ollama)
HF_GENERATION_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# Backend forcé : ollama | huggingface | none (auto-détecté si vide)
GENERATOR_BACKEND=

# Paths
DATA_PATH=./data/documents
CHROMA_PATH=./data/chroma_db

# API Settings
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit Settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# Debug
DEBUG=false