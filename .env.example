# Hugging Face 
HUGGINGFACE_API_KEY=your_key_here

# Embedding model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Generation model (Ollama local)
GENERATION_MODEL=mistral:7b-instruct

# Groq Cloud (free, recommended) — get a key at console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# HuggingFace (most models require a Pro account)
HF_GENERATION_MODEL=HuggingFaceH4/zephyr-7b-beta

# Force a backend: ollama | groq | huggingface | none (auto-detected if empty)
GENERATOR_BACKEND=

# Paths
DATA_PATH=./data/documents
CHROMA_PATH=./data/chroma_db

# API Settings
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit Settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# Debug
DEBUG=false